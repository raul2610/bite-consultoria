# Copiar este archivo a terraform.tfvars y completar los valores
aws_region           = "us-east-1"
environment          = "dev"
name                 = "bite"
vpc_cidr             = "10.4.0.0/16"
instance_type        = "t3.small"
asg_min_size         = 1
asg_max_size         = 10
asg_desired_capacity = 2
asg_target_cpu       = 50
container_image      = "nginx:latest"
container_port       = 80
task_cpu             = 256
task_memory          = 512
ecs_desired_count    = 2
ecs_min_count        = 1
ecs_max_count        = 10
ecs_target_cpu       = 50
